# pet-agent 环境变量示例（复制为 .env 或直接 export）
#
# 决策 D46：**每个能力可以指向不同的供应商**。
# 缺省值见 app/llm/providers.py 的预设；下面全部可选，除非标注「必填」。

# ─────────────────────────────────────────────────────────────
# 供应商选择
# ─────────────────────────────────────────────────────────────
# dashscope | ark。缺省时按 key 名推断（ARK_API_KEY 优先于 DASHSCOPE_API_KEY）。
PET_AGENT_PROVIDER=ark

# 供应商主密钥（二者至少配一个；都缺则退到 mock，但 /healthz 会明确标注）。
DASHSCOPE_API_KEY=
ARK_API_KEY=

# 裸密钥：不携带供应商身份 → 使用有文档的默认供应商（ark）。
# 用 DashScope 时请直接设 DASHSCOPE_API_KEY 或显式设 PET_AGENT_PROVIDER=dashscope。
PET_AGENT_API_KEY=

# 强制全部走 mock（离线可跑、CI 不花钱）。1/true/yes/on。
#
# ⚠️ 设 1 会让**视觉显式失败**（UnavailableVision）—— 那是刻意的（D45）：
# 没接视觉后端不得假装看得见。想离线跑通档案链路就**别设它**：
# 无密钥时用确定性的 MockVision，多图取交集仍可跑。
MOCK_PROVIDER=0

# ─────────────────────────────────────────────────────────────
# 逐能力覆盖（PET_AGENT_<能力>_<字段>）
#   能力：LLM / VISION / EMBED / MULTIMODAL
#   字段：MODEL / BASE_URL / PATH / API_KEY / TIMEOUT_S
# 例：LLM 用方舟、向量用 DashScope
# ─────────────────────────────────────────────────────────────
# PET_AGENT_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# PET_AGENT_LLM_MODEL=<你账号里可用的方舟模型名>
# PET_AGENT_LLM_API_KEY=<方舟 key>
# PET_AGENT_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PET_AGENT_EMBED_MODEL=text-embedding-v4
# PET_AGENT_EMBED_API_KEY=<DashScope key>

# 向量维度必须与 Milvus collection 一致（默认 1024）。非整数会拒绝启动。
PET_AGENT_EMBED_DIM=1024

# ⚠️ 方舟的视频/音频理解走**未实现**的 Responses API，所以预设里**不声明**
# MULTIMODAL 能力。只有在你实现了适配器后才显式开启：
# PET_AGENT_MULTIMODAL_MODEL=<omni 模型名>
# PET_AGENT_MULTIMODAL_PATH=/chat/completions

# ─────────────────────────────────────────────────────────────
# 数据库配置
# ─────────────────────────────────────────────────────────────
# MySQL 主数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=pet_agent
MYSQL_USER=pet_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Milvus 向量数据库
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=

# ─────────────────────────────────────────────────────────────
# 运行时（app/bootstrap.py）
# ─────────────────────────────────────────────────────────────
# 鉴权签名密钥。**必填，缺则拒绝启动** —— 否则 user_id 可伪造，租户隔离不成立。
# 兼容别名：AUTH_SECRET / AUTH_DEV_TOKEN
PET_AGENT_AUTH_SECRET=change-me-to-a-random-secret

# 先验表路径（缺省 data/priors/catmeows_stats.json）
# PET_AGENT_PRIORS_PATH=./data/priors/catmeows_stats.json

# 下载待分析音频的超时（秒）。非数字会拒绝启动。
PET_AGENT_MEDIA_TIMEOUT_S=30

# ─────────────────────────────────────────────────────────────
# 观测（LangSmith）
# ─────────────────────────────────────────────────────────────
# 开关。缺省规则：有 key 就启用；显式设为 0 可**压过** key（CI / 测试用）。
# PET_AGENT_TRACING=1

# 密钥与项目名。本项目命名优先，兼容 LANGSMITH_* 与旧 LANGCHAIN_* 名。
# PET_AGENT_LANGSMITH_API_KEY=ls__...
# PET_AGENT_LANGSMITH_PROJECT=pet-agent
# 自托管或区域端点，缺省 api.smith.langchain.com
# PET_AGENT_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
#
# trace_id 与 LangSmith run id 的关系：
#   trace_id 是 UUID      → 直接用作 run_id（同一个标识）
#   trace_id 是自定义串   → uuid5 确定性派生
# 两种情况下 trace_id 都写进 metadata，可在 LangSmith 按它检索。
#
# 请求头（任一请求都可带，缺省服务端生成并在响应头回传）：
#   X-Session-Id: <会话标识>   同一会话多次请求共享它，会话记忆注入按它取最近 N 轮
#   X-Trace-Id:   <链路标识>   与 LangSmith run id 同源

# 签发一个开发用 token（所有端点都需要 Bearer token）：
#   python -m app.bootstrap --issue-token user-1
# 查看当前装配到的厂商 / 模型 / 端点：
#   python -m app.bootstrap --describe
